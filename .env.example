# Copy to .env for local use (never commit .env).

# --- Image API (any OpenAI-compatible /images/generations endpoint) ---
IMAGE_API_KEY=
IMAGE_API_BASE=https://api.openai.com/v1
# gpt-image-1 shuts down 2026-10-23; gpt-image-1-mini and gpt-image-1.5 on 2026-12-01.
IMAGE_MODEL=gpt-image-2.5-flare
# Leave empty to omit the "size" field (some providers use a different field, see IMAGE_PARAMS).
IMAGE_SIZE=1024x1024
# Extra JSON merged into the request body, e.g. {"quality":"medium"}. Default is the cheapest tier: quality=low.
IMAGE_PARAMS=

# --- Spend tracking (counts only calls made through this server) ---
# A banner appears in the app once the running total passes this many USD.
BUDGET_WARN_USD=50
# Where the image cache (data/cache) and the spend ledger (data/ledger.json) live.
# DATA_DIR=./data
# Used only if the API response has no token usage, or the model is not in the built-in price table.
FALLBACK_COST_USD=0.02
# Optional price override in USD per 1M tokens: "text input,image input,image output"
# PRICE_PER_M=5,8,30

# --- Sync storage ---
# Local: leave these empty, data goes to ./data as plain files.
# Online (e.g. Render, whose free disk is wiped on restart): create a free Redis at console.upstash.com
# and paste the REST URL and token from its "REST API" section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set to 1 only if DATA_DIR sits on a persistent disk (silences the "ephemeral disk" warning on Render).
# DATA_DIR_PERSISTENT=1

# --- Protection ---
# Comma-separated list of allowed browser origins, e.g. https://yourname.github.io
# "*" allows everyone (fine for local dev).
ALLOWED_ORIGINS=*
# REQUIRED for any remote use: the diary is private. Without it the API only answers requests from this machine.
# Every device enters the same code once (Settings -> 访问口令).
ACCESS_CODE=
# Per-IP requests per minute and total generations per day.
RATE_PER_MIN=6
DAILY_LIMIT=200

PORT=3000
